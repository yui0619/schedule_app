<%= render "shared/partial" %>

<% if flash[:notice] %>
  <class="notice"><%= flash[:notice] %></p>
<% end %>

<div>
  <h2 class="left"><nobr>予定一覧</nobr></h2>
  <button class=""><%= link_to "新規追加", :new_plan %></button>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>詳細</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @plans.each do |plan| %>
      <tr>
        <td><%= plan.id %></td>
        <td><%= plan.title %></td>
        <td><%= plan.start_date.strftime("%Y/%m/%d") %></td>
        <td><%= plan.end_date.strftime("%Y/%m/%d") %></td>
        <td><%= plan.all_day ? '○' : '' %></td>
        <td><%= plan.updated_at.to_s(:datetime_jp) %></td>
        <td>
          <%= link_to "詳細", plan %>
        </td>
        <td>
          <%= link_to "編集", [:edit, plan] %>
        </td>
        <td>
          <%= link_to "削除",  plan, method: :delete, data: { confirm: "本当に削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

  <p class="left-footer"><nobr>予定合計 <%= Plan.count %>件</nobr></p>
  <p class="right">本日の日付 <%= get_today_date %></p>



